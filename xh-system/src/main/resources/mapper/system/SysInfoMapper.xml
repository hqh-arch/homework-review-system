<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysInfoMapper">

    <resultMap type="SysInfo" id="SysInfoResult">
    </resultMap>

    <sql id="selectSysInfoVo">
        select *from sys_info
    </sql>

    <select id="list" parameterType="SysInfo" resultMap="SysInfoResult">
        <include refid="selectSysInfoVo"/>
        <where>
            <if test="cond != null and cond != ''">and (name like #{cond} or id like #{cond})</if>
        </where>
    </select>

    <select id="getOne" parameterType="String" resultMap="SysInfoResult">
        <include refid="selectSysInfoVo"/>
        where id = #{id}
    </select>

    <insert id="add" parameterType="SysInfo">
        insert into sys_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="name != null">name,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="name != null">#{name},</if>
        </trim>
    </insert>

    <update id="update" parameterType="SysInfo">
        update sys_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="delete" parameterType="String">
        delete from sys_info where id = #{id}
    </delete>

    <delete id="remove" parameterType="String">
        delete from sys_info where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>